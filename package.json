{
  "name": "intent-prompt-graph",
  "version": "0.1.9",
  "description": "A live browser graph of a coding-agent conversation, grouped by intent. Standalone `ipg` CLI plus plugins for OMP and Claude Code that add /ipg.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "omp",
    "bun",
    "cli",
    "graph"
  ],
  "homepage": "https://github.com/umiddey/intent-prompt-graph#readme",
  "bugs": "https://github.com/umiddey/intent-prompt-graph/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umiddey/intent-prompt-graph.git"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "web",
    "integrations",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ipg": "src/cli.ts"
  },
  "omp": {
    "extensions": [
      "./integrations/omp/intent-graph.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
